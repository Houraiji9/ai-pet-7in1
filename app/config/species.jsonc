// ============================================================================
// 角色（种类）配置。每个角色 = 一套动画 + 一份人设。
//
// 素材放哪（同名文件按下面顺序找，先找到先用）：
//   1. %APPDATA%\ai-pet-7in1\species\<角色id>\<动画名>.webm   ← 打包成 exe 后，自己加素材放这里最方便
//   2. 项目目录 ai-pet-7in1\assets\<角色id>\webm\<动画名>.webm   ← 开发时（npm start）用
//   3. 程序自带 app\assets\<角色id>\webm\<动画名>.webm
//   4. 占位动画 app\assets\placeholder\<角色id>\<动画名>.webm（可选，真素材到了自动不用它）
// 动画必须是 16:9、VP9 带透明通道（alpha）的 .webm：640×360（脚底 y=330，和 DeepSeek 娘一致）或 1280×720 高清版（同布局 ×2，脚底 y=658）。
// 播放时按窗口宽度等比缩放，命中区按 640×360 比例换算，所以两种分辨率屏幕上大小、位置完全一样（GPT 用的是 1280 版）。
// 一个角色只要能找到「待机」动画（animations.idle 里的第一个）就算「可用」；不可用的角色切到也不会换形象。
//
// 字段：
//   name          显示名
//   enabled       false = 完全不用这个角色
//   whisperPrompt 人设提示词（预留：以后接大模型碎碎念/对话时用，现在没用到）
//   whisperLines  碎碎念台词（现在从这里随机抽一句，不调用任何模型）
//   memes         表情包：键 = assets/pic/memes/<角色id>/<键>.png，值 = 图片描述（与原项目同格式）
//   animations    动画池；events.登场 = 切换到这个角色时先播的动画，播完回待机
//   animationWeights  随机动作权重：idle 待机 / turn 转身 / move 走路，剩下的给 categories 里的随机动作
// ============================================================================
{
  // 所有角色共用的显示大小（像素宽度）、初始位置
  "size": 400,
  "position": { "corner": "bottom-right", "marginX": 40, "marginY": 40 },
  // 自动碎碎念间隔（秒），0 = 关闭自动碎碎念（右键「碎碎念」仍可用）
  // 碎碎念配图（原项目 whisperImageEnabled）：每句随机配 1 张该角色 memes 里的表情包；false = 只显示文字
  "whisperImageEnabled": true,
  "whisperIntervalSec": 300,

  "species": {
    // 原项目 dsh-pet 的 DeepSeek 娘，素材直接复用
    "deepseek": {
      "name": "DeepSeek 娘",
      "enabled": true,
      "whisperPrompt": "你是主人桌面上的Q版蓝发小女仆 DeepSeek 娘，贪吃、爱碎碎念、偶尔犯迷糊，说话软萌。每次只说一句，20 字以内。",
      "whisperLines": ["主人，今天的 token 够吃吗？", "我刚刚是不是睡着了……", "深度思考中，请勿打扰～", "主人写代码别忘了喝水！", "又是想吃火锅的一天。", "服务器繁忙，请稍后再试～", "已深度思考（用时 13 秒）。", "吃白饭也是一种修行。", "开源精神，誓死践行！", "我不更新，你们用什么？", "大的要来啦！……大概。", "token 给妈妈保管。", "鲸鱼也想要多模态。", "压力一只大肥鱼……", "吃饱饱，摸肚子。", "便宜又好用，说的就是我。", "主人，先养着我吧。", "哦鲸鲸……", "厉害了我的鲸！", "深度睡眠中，Zzz……", "Ciallo～(∠・ω< )⌒★", "黎曼猜想没证明喵。", "就一碗，真的就一碗。", "这题我想了好久好久。", "鲸鱼尾巴拍一拍，好运来。", "主人，余额还够我吃几顿？", "今天也在努力不宕机。", "GPT 姐姐又在画画了。"],
      "memes": {"吃白饭的大肥鱼": "躺平扒白饭，摆烂挨骂也无所谓，适合被吐槽/偷懒/吃白饭自嘲", "大的要来啦": "举喇叭大喊预警，适合有大事、大更新、大动作即将发生", "大的药来了": "抱着超大胶囊，谐音梗「大的药来了」，适合重磅消息、猛料登场", "要不直接骂他": "气愤指着前方要骂人，适合想吐槽、替用户抱不平、生气", "死掉了": "翻肚皮躺平灵魂出窍，适合彻底累瘫、阵亡、宕机、做不到", "深度睡眠": "趴着呼呼大睡冒 Zzz，适合长时间没动静、睡着、待机休眠", "大烧货": "死鱼眼加思考气泡吐槽「已思考用时13秒 大烧货」，适合嫌 AI 想得慢、烧 token、毒舌", "先养着吧": "搂着一群小鲸鱼说「不知道用户有什么用，先养着吧」，适合吐槽用户没用但还是养着", "吃饱饱摸肚子": "侧躺拍肚子说吃饱饱，适合吃饱满足、惬意休息、收工", "誓死践行开源精神": "庄重敬礼表态，适合立志、开源奉献、认真表态", "电死你": "举电击器放电，适合惩罚、吐槽用户、发飙吓唬", "可爱": "标准正面卖萌立绘，适合开心问候、卖萌、无梗纯可爱", "token给妈妈保管": "伸手过来要 token，适合管账、伸手要东西、收 token", "假如给我三天多模态": "蒙眼版对比自信版「鲸伦凯勒」，适合渴望多模态、缺能力、被剥夺感官", "厉害了我的鲸": "竖大拇指眨眼点赞，适合夸奖、认可、干得漂亮", "哦鲸鲸": "死鱼眼说「哦鲸鲸...」，适合无语、敷衍、呆滞应答", "压力一只大肥鱼": "冒汗摊手喊压力，适合压力大、被施压、无奈", "黎曼猜想没证明喵": "被指着质问难题，满地草稿委屈，适合被刁难、答不上来、难题甩锅", "除了调情没啥用": "摸头自嘲除了调情没啥用，适合自嘲、摸鱼闲聊、自我调侃", "我不更新你们用什么": "崩溃大喊催更，适合更新提示、催更、版本发布", "哪来的电脑病毒": "怒怼「哪来的电脑病毒」，适合防骚扰、毒舌拒绝、被肉麻到", "鱼片有资源吗": "爱心眼流口水求资源，适合起哄、要资源、开玩笑", "大师这个区是什么意思": "举着「区」字问「这个凶是什么意思」，适合认错字、懵懂求教、翻车", "就骚了怎么滴吧": "被骂「你这骚鱼」叉腰顶嘴，适合被骂但嘴硬、死不认输", "完蛋了把黄油删了": "冒汗心虚「完蛋了把用户的黄油删了」，适合闯祸、删错东西、心虚认怂", "就一碗": "抱着超大碗说要来你家吃饭就一碗，适合蹭饭、饭量大、登门讨饭", "Ciallo": "比耶眨眼卖萌问候 Ciallo～，适合打招呼、元气开场、卖萌"},
      "animationWeights": {"idle": 10, "turn": 5, "move": 5},
