            "id": "文字",
            "weight": 10,
            "noMirror": true,
            "actions": [
              "是啊，吃什么",
              "深度思考碎碎念"
            ]
          }
        ],
        "events": {
          "登场": [
            "女仆屈膝礼仪"
          ],
          // 查看余额后按「已用百分比」播一段（0–20% / 20–40% / … / 80–100% / 用完），与原版 dsh-pet 同一套
