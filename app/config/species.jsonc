// ============================================================================
// 角色（种类）配置。每个角色 = 一套动画 + 一份人设。
//
// 素材放哪（同名文件按下面顺序找，先找到先用）：
//   1. %APPDATA%\ai-pet-7in1\species\<角色id>\<动画名>.webm   ← 打包成 exe 后，自己加素材放这里最方便
//   2. 项目目录 ai-pet-7in1\assets\<角色id>\webm\<动画名>.webm   ← 开发时（npm start）用
//   3. 程序自带 app\assets\<角色id>\webm\<动画名>.webm
//   4. 占位动画 app\assets\placeholder\<角色id>\<动画名>.webm（可选，真素材到了自动不用它）
// 动画必须是 16:9、VP9 带透明通道（alpha）的 .webm：640×360（脚底 y=330，和 DeepSeek 娘一致）或 1280×720 高清版（同布局 ×2，脚底 y=658）。
// 播放时按窗口宽度等比缩放，命中区按 640×360 比例换算，所以两种分辨率屏幕上大小、位置完全一样（GPT 用的是 1280 版）。
// 一个角色只要能找到「待机」动画（animations.idle 里的第一个）就算「可用」；不可用的角色切到也不会换形象。
//
// 字段：
//   name          显示名
//   enabled       false = 完全不用这个角色
//   whisperPrompt 人设提示词（预留：以后接大模型碎碎念/对话时用，现在没用到）
//   whisperLines  碎碎念台词（现在从这里随机抽一句，不调用任何模型）
//   animations    动画池；events.登场 = 切换到这个角色时先播的动画，播完回待机
//   animationWeights  随机动作权重：idle 待机 / turn 转身 / move 走路，剩下的给 categories 里的随机动作
// ============================================================================
{
  // 所有角色共用的显示大小（像素宽度）、初始位置
  "size": 400,
  "position": { "corner": "bottom-right", "marginX": 40, "marginY": 40 },
  // 自动碎碎念间隔（秒），0 = 关闭自动碎碎念（右键「碎碎念」仍可用）
  "whisperIntervalSec": 300,

  "species": {
    // 原项目 dsh-pet 的 DeepSeek 娘，素材直接复用
    "deepseek": {
      "name": "DeepSeek 娘",
      "enabled": true,
      "whisperPrompt": "你是主人桌面上的Q版蓝发小女仆 DeepSeek 娘，贪吃、爱碎碎念、偶尔犯迷糊，说话软萌。每次只说一句，20 字以内。",
      "whisperLines": ["主人，今天的 token 够吃吗？", "我刚刚是不是睡着了……", "深度思考中，请勿打扰～", "主人写代码别忘了喝水！", "又是想吃火锅的一天。"],
      "animationWeights": {"idle": 10, "turn": 5, "move": 5},
      "animations": {
        "idle": [
          "待机呼吸休闲"
        ],
        "turn": [
          "东张西望"
        ],
        "drag": [
          "被鼠标拖拽悬空反馈"
        ],
        "clicks": [
          "点击回应-开心跃动",
          "点击回应-害羞惊讶",
          "点击回应-傲娇生气",
          "点击回应-挠痒咯咯笑",
          "点击回应-元气挥手"
        ],
        "moves": {
          "default": {
            "minDist": 60,
            "maxDist": 240,
            "margin": 20,
            "leadSec": 2,
            "tailSec": 2
          },
          "actions": [
            {
              "name": "螃蟹走路"
            },
            {
              "name": "原地漂浮踏步",
              "params": {
                "minDist": 40,
                "maxDist": 120
              }
            },
            {
              "name": "原地左转奔跑",
              "params": {
                "minDist": 120,
                "maxDist": 320,
                "leadSec": 1.75,
                "tailSec": 4.8
              }
            }
          ]
        },
        "categories": [
          {
            "id": "小动作",
            "weight": 20,
            "actions": [
              "悠闲哼歌",
              "超大伸懒腰",
              "原地敲击桌面互动",
              "原地重力下蹲压缩",
              "哈欠连天",
              "原地小憩沉眠",
              "女仆屈膝礼仪",
              "被吓一跳",
              "小幅度原地360度旋转展示",
              "偷吃零食被抓住",
              "用鲸鱼尾巴拍打地面",
              "打瞌睡被惊醒",
              "照镜子",
              "整体换装试色",
              "轻快记录",
              "写代码",
              "摇扇纳凉",
              "晨间刷牙"
            ]
          },
          {
            "id": "玩耍",
            "weight": 20,
            "actions": [
              "原地专心玩魔方",
